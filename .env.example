# Satu file env untuk BE dan FE. Salin ke .env lalu isi nilainya.
# Masing-masing app hanya memvalidasi variabel miliknya (BE/src/lib/env.ts, FE/src/lib/env.ts).

# BE
# Kredensial Postgres dev di Docker (service db di compose.yaml). Dipakai saat container dibuat pertama kali.
POSTGRES_USER=training_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=training_dev
# Koneksi Prisma ke Postgres. User, password, dan nama DB harus sama dengan POSTGRES_* di atas.
# Port 5433: Docker lokal sekarang, nanti SSH tunnel ke VPS dengan port yang sama.
DATABASE_URL=postgresql://training_user:change-me-db-password@localhost:5433/training_dev
# Secret untuk menandatangani sesi admin, minimal 32 karakter.
SESSION_SECRET=change-me-to-a-random-string-of-32-chars
# Folder tempat file upload disimpan di disk. Path relatif dihitung dari folder BE/ (cwd npm script),
# jadi ../uploads = folder uploads/ di root repo (gitignored). Di Docker ditimpa compose.yaml.
UPLOAD_DIR=../uploads
# URL publik website, dipakai untuk membentuk URL file upload.
PUBLIC_BASE_URL=http://localhost:3000
# Endpoint revalidate di FE yang dipanggil BE setelah mutasi konten.
FE_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Origin yang boleh mengirim request mutasi (POST/PATCH/PUT/DELETE), dipisah koma.
ALLOWED_ORIGINS=http://localhost:3000
# Jumlah proxy tepercaya yang MENAMBAH entri X-Forwarded-For. IP klien = entri ke-N dari kanan.
# Rewrite FE (Next) tidak menambah entri: XFF dari klien diteruskan apa adanya, dan hanya diisi IP
# socket kalau kosong. Dev: 1. Di VPS nanti ada reverse proxy (nginx) di depan FE: nilainya tetap 1
# selama nginx satu-satunya yang menambah/menimpa XFF; tambah 1 untuk tiap proxy lain (mis. CDN).
# Tanpa reverse proxy di depan FE, XFF bisa dipalsukan klien (rate limit login bisa diakali).
TRUST_PROXY_HOPS=1
# Admin pertama, dibuat oleh seed hanya kalau email ini belum ada (password lama tidak ditimpa).
ADMIN_EMAIL=admin@example.com
# Minimal 12 karakter.
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin
# Secret endpoint revalidate, minimal 16 karakter. Dipakai juga oleh FE.
REVALIDATE_SECRET=change-me-revalidate-secret

# FE
# URL internal BE, tujuan rewrite /api/* dan /uploads/*.
BE_INTERNAL_URL=http://localhost:4000
# URL publik website (canonical, sitemap, metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
