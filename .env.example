# Satu file env untuk BE dan FE. Salin ke .env lalu isi nilainya.
# Masing-masing app hanya memvalidasi variabel miliknya (BE/src/lib/env.ts, FE/src/lib/env.ts).

# BE
# Kredensial Postgres dev di Docker (service db di compose.yaml). Dipakai saat container dibuat pertama kali.
POSTGRES_USER=training_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=training_dev
# Koneksi Prisma ke Postgres. User, password, dan nama DB harus sama dengan POSTGRES_* di atas.
# Port 5433: Docker lokal sekarang, nanti SSH tunnel ke VPS dengan port yang sama.
DATABASE_URL=postgresql://training_user:change-me-db-password@localhost:5433/training_dev
# Database khusus e2e Playwright, di instance yang sama. Di-drop, dibuat ulang, dan di-seed sebelum
# setiap run (npm run test:e2e). Nama database wajib training_e2e; script menolak nama lain.
DATABASE_URL_E2E=postgresql://training_user:change-me-db-password@localhost:5433/training_e2e
# Secret untuk menandatangani sesi admin, minimal 32 karakter.
SESSION_SECRET=change-me-to-a-random-string-of-32-chars
# Folder tempat file upload disimpan di disk. Path relatif dihitung dari folder BE/ (cwd npm script),
# jadi ../uploads = folder uploads/ di root repo (gitignored). Di Docker ditimpa compose.yaml.
UPLOAD_DIR=../uploads
# URL publik website, dipakai untuk membentuk URL file upload.
PUBLIC_BASE_URL=http://localhost:3000
# Endpoint revalidate di FE yang dipanggil BE setelah mutasi konten.
FE_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Origin yang boleh mengirim request mutasi (POST/PATCH/PUT/DELETE), dipisah koma.
ALLOWED_ORIGINS=http://localhost:3000
# Jumlah proxy tepercaya yang MENAMBAH entri X-Forwarded-For. IP klien = entri ke-N dari kanan.
# Rewrite FE (Next) meneruskan X-Forwarded-For dan X-Real-IP dari klien apa adanya dan TIDAK
# mengisinya kalau kosong (dicek 14 Okt 2026, Next 16.4). Tanpa reverse proxy (dev, Docker lokal):
# pengunjung tanpa XFF terbaca "unknown" dan IP bisa dipalsukan klien (rate limit login/inquiry).
# Produksi (nginx -> FE -> BE): 1, dengan syarat nginx menyetel XFF
# (`proxy_set_header X-Forwarded-For $remote_addr;` atau `$proxy_add_x_forwarded_for`) dan port FE/BE
# hanya listen di 127.0.0.1. Tambah 1 untuk tiap proxy lain di depan nginx yang menambah entri (CDN).
TRUST_PROXY_HOPS=1
# IP klien tidak terbaca (X-Forwarded-For kosong) di rate limit login, inquiry, dan search publik:
# shared = semua pengunjung tanpa IP berbagi satu bucket (fail-safe) + peringatan sekali di log BE.
# skip   = limit per IP dilewati untuk IP tak terbaca (limit per email inquiry tetap; login tetap
#          dibatasi lewat satu bucket bersama). HANYA untuk Docker/dev lokal tanpa reverse proxy.
#          Produksi wajib shared (default).
RATE_LIMIT_UNKNOWN_IP=shared
# Satu-satunya admin, dibuat oleh seed hanya kalau belum ada admin (password lama tidak ditimpa).
# Login panel admin cukup dengan kata sandi ini, tanpa email. Minimal 12 karakter.
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin
# Secret endpoint revalidate, minimal 16 karakter. Dipakai juga oleh FE.
REVALIDATE_SECRET=change-me-revalidate-secret
# E2E_SERVER=1 dipasang otomatis oleh script e2e (folder build .next/e2e). Jangan diisi di sini.

# FE
# URL internal BE, tujuan rewrite /api/* dan /uploads/*.
BE_INTERNAL_URL=http://localhost:4000
# URL publik website (canonical, sitemap, metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opsional, hanya untuk uji build produksi lokal: folder build terpisah dari `next dev`, wajib di
# bawah .next/ (bukan .next/dev atau .next/e2e). Biarkan kosong di .env; isi saat menjalankan uji,
# mis. NEXT_DIST_DIR=.next/verify npm run build && NEXT_DIST_DIR=.next/verify npm run start
# NEXT_DIST_DIR=.next/verify
