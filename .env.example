# Satu file env untuk BE dan FE. Salin ke .env lalu isi nilainya.
# Masing-masing app hanya memvalidasi variabel miliknya (BE/src/lib/env.ts, FE/src/lib/env.ts).

# BE
# Kredensial Postgres dev di Docker (docker/compose.dev.yml). Dipakai saat container dibuat pertama kali.
POSTGRES_USER=training_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=training_dev
# Koneksi Prisma ke Postgres. User, password, dan nama DB harus sama dengan POSTGRES_* di atas.
# Port 5433: Docker lokal sekarang, nanti SSH tunnel ke VPS dengan port yang sama.
DATABASE_URL=postgresql://training_user:change-me-db-password@localhost:5433/training_dev
# Secret untuk menandatangani sesi admin, minimal 32 karakter.
SESSION_SECRET=change-me-to-a-random-string-of-32-chars
# Folder tempat file upload disimpan di disk.
UPLOAD_DIR=./uploads
# URL publik website, dipakai untuk membentuk URL file upload.
PUBLIC_BASE_URL=http://localhost:3000
# Endpoint revalidate di FE yang dipanggil BE setelah mutasi konten.
FE_REVALIDATE_URL=http://localhost:3000/api/revalidate
# Secret endpoint revalidate, minimal 16 karakter. Dipakai juga oleh FE.
REVALIDATE_SECRET=change-me-revalidate-secret

# FE
# URL internal BE, tujuan rewrite /api/* dan /uploads/*.
BE_INTERNAL_URL=http://localhost:4000
# URL publik website (canonical, sitemap, metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
