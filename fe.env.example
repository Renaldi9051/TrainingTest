# URL internal BE, tujuan rewrite /api/* dan /uploads/*.
BE_INTERNAL_URL=http://localhost:4000
# URL publik website (canonical, sitemap, metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret bersama BE-FE untuk endpoint revalidate, minimal 16 karakter. Harus sama dengan di be.env.
REVALIDATE_SECRET=change-me-revalidate-secret
