// Skema database BE. URL koneksi ada di prisma.config.ts (dari DATABASE_URL di .env root).
//
// Konvensi:
// - id: UUID v7 (urut waktu).
// - Waktu: timestamptz. Tanggal tanpa jam (jadwal, portofolio): date.
// - Tabel konten: createdAt, updatedAt, deletedAt (soft delete), updatedById.
// - Slug / Redirect.from: unik hanya di antara baris yang belum dihapus (partial unique index),
//   supaya slug item di Sampah tidak mengunci slug baru. Query publik wajib filter deletedAt: null.
// - Rich text (Tiptap) disimpan sebagai Json.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ===== Enum =====

enum NavLocation {
  HEADER
  FOOTER
}

enum HomeSectionType {
  HERO
  STATS
  SERVICES
  CATEGORIES
  LATEST_TRAININGS
  UPCOMING_SCHEDULES
  CLIENTS
  VISION_MISSION
  TESTIMONIALS
  CTA
  // Teks besar berjalan mengikuti scroll (VelocityMarquee), Fase 4.1e.
  MARQUEE
}

// PROFILE = halaman sistem /profil: hanya satu, tidak bisa dihapus, slug terkunci "profil".
enum PageKind {
  STANDARD
  PROFILE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum TrainingMethod {
  ONLINE
  OFFLINE
  HYBRID
}

enum TrainingType {
  PUBLIC
  IN_HOUSE
}

// Tingkat pelatihan (label publik: DASAR / MENENGAH / LANJUTAN). null = tidak ditampilkan.
enum TrainingLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Jenis kegiatan portofolio (chip filter /profil/portofolio). null = belum diisi, tidak ikut filter.
enum PortfolioActivityType {
  FIELD
  CLASSROOM
  CERTIFICATION
  OUTBOUND
}

enum ScheduleStatus {
  OPEN
  FULL
  COMPLETED
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  DONE
}

// Asal inquiry: tombol di detail pelatihan atau form halaman /kontak.
enum InquirySource {
  TRAINING_DETAIL
  CONTACT
}

// PERMANENT = HTTP 301, TEMPORARY = HTTP 302.
enum RedirectCode {
  PERMANENT
  TEMPORARY
}

// ===== Auth =====

// Semua admin setara (tidak ada role).
model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  name         String
  passwordHash String
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  sessions  Session[]
  auditLogs AuditLog[]

  updatedSiteSettings      SiteSetting[]
  updatedNavItems          NavItem[]
  updatedHomeSections      HomeSection[]
  updatedPages             Page[]
  updatedServices          Service[]
  updatedCategories        Category[]
  updatedTrainings         Training[]
  updatedSchedules         Schedule[]
  updatedClients           Client[]
  updatedTestimonials      Testimonial[]
  updatedPortfolioItems    PortfolioItem[]
  updatedMarketingContacts MarketingContact[]
  updatedMediaPartners     MediaPartner[]
  updatedMedia             Media[]
  updatedInquiries         Inquiry[]
  updatedRedirects         Redirect[]
}

model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // HMAC-SHA256(token, SESSION_SECRET). Token asli hanya ada di cookie.
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

// ===== Pengaturan & navigasi =====

model SiteSetting {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  value       Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model NavItem {
  id          String      @id @default(uuid(7)) @db.Uuid
  location    NavLocation
  label       String
  href        String
  // Nested 1 level; batas kedalaman dicek di service.
  parentId    String?     @db.Uuid
  parent      NavItem?    @relation("NavItemChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children    NavItem[]   @relation("NavItemChildren")
  order       Int         @default(0)
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?   @db.Timestamptz(3)
  updatedById String?     @db.Uuid
  updatedBy   User?       @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([location, order])
  @@index([parentId])
  @@index([deletedAt])
}

// ===== Konten halaman =====

model HomeSection {
  id          String          @id @default(uuid(7)) @db.Uuid
  type        HomeSectionType
  title       String?
  // Bentuk content divalidasi Zod per type di BE.
  content     Json
  order       Int             @default(0)
  visible     Boolean         @default(true)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?       @db.Timestamptz(3)
  updatedById String?         @db.Uuid
  updatedBy   User?           @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  // HERO dan CTA masing-masing maksimal satu di antara section yang belum dihapus.
  // Index ditulis manual di migrasi phase3_pages_home (`"type" IN ('HERO', 'CTA') AND ...`).
  // Predikat di sini disalin persis dari `prisma db pull --print` (bentuk yang disimpan Postgres:
  // IN -> = ANY (ARRAY[...])). Bentuk lain membuat migrate dev melihat drift dan men-generate
  // DROP INDEX + CREATE INDEX. Cek: prisma migrate diff --from-config-datasource --to-schema.
  @@unique([type], map: "HomeSection_single_type_key", where: raw("((type = ANY (ARRAY['HERO'::\"HomeSectionType\", 'CTA'::\"HomeSectionType\"])) AND (\"deletedAt\" IS NULL))"))
  @@index([order])
  @@index([deletedAt])
}

model Page {
  id          String        @id @default(uuid(7)) @db.Uuid
  kind        PageKind      @default(STANDARD)
  slug        String
  title       String
  // Blok konten, divalidasi Zod per type di BE (lib/validators/page-blocks.ts).
  blocks      Json
  status      ContentStatus @default(DRAFT)
  seo         Json?
  publishedAt DateTime?     @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?     @db.Timestamptz(3)
  updatedById String?       @db.Uuid
  updatedBy   User?         @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([slug], map: "Page_slug_active_key", where: raw("\"deletedAt\" IS NULL"))
  // Hanya satu halaman PROFILE (ditulis manual di migrasi phase3_pages_home).
  @@unique([kind], map: "Page_profile_key", where: raw("\"kind\" = 'PROFILE'"))
  @@index([status])
  @@index([deletedAt])
}

model Service {
  id                String        @id @default(uuid(7)) @db.Uuid
  slug              String
  title             String
  // Label mono di bawah judul. null = tidak tampil.
  tagline           String?
  icon              String?
  summary           String?
  body              Json?
  // { icon, title, description }[]; kosong = section benefit disembunyikan.
  benefits          Json          @default("[]")
  // { q, a }[]; kosong = section FAQ disembunyikan.
  faqs              Json          @default("[]")
  // Pelatihan terkait: { mode: "manual", ids } (maks 12); null = section tidak tampil.
  trainingSelection Json?
  imageId           String?       @db.Uuid
  image             Media?        @relation(fields: [imageId], references: [id], onDelete: SetNull)
  order             Int           @default(0)
  status            ContentStatus @default(DRAFT)
  seo               Json?
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?     @db.Timestamptz(3)
  updatedById       String?       @db.Uuid
  updatedBy         User?         @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([slug], map: "Service_slug_active_key", where: raw("\"deletedAt\" IS NULL"))
  @@index([status])
  @@index([order])
  @@index([deletedAt])
}

// ===== Katalog pelatihan =====

model Category {
  id          String    @id @default(uuid(7)) @db.Uuid
  slug        String
  name        String
  description String?
  icon        String?
  order       Int       @default(0)
  featured    Boolean   @default(false)
  // Gambar kategori: fallback sampul pelatihan tanpa cover dan foto di landing kategori.
  imageId     String?   @db.Uuid
  image       Media?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  updatedById String?   @db.Uuid
  updatedBy   User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  trainings TrainingCategory[]

  @@unique([slug], map: "Category_slug_active_key", where: raw("\"deletedAt\" IS NULL"))
  @@index([featured])
  @@index([order])
  @@index([deletedAt])
}

model Training {
  id                   String                   @id @default(uuid(7)) @db.Uuid
  slug                 String
  title                String
  // Satu kalimat, maks 200 karakter (divalidasi Zod di BE).
  summary              String?
  // Rich text Tiptap (dulu `body`); admin diberi hint maks 2 paragraf.
  description          Json?
  // Hasil belajar: 4-8 item (wajib saat Tayang), tiap item maks 160 karakter.
  outcomes             String[]                 @default([])
  // Materi: { title, points: string[], durationMinutes? }[]
  modules              Json                     @default("[]")
  // Target peserta: { role, note? }[]
  audience             Json                     @default("[]")
  prerequisites        String?
  // string[]; null = pakai SiteSetting training.defaults.facilities
  facilities           Json?
  // FAQ khusus pelatihan { q, a }[]; tampil sebelum FAQ global (training.defaults.faq)
  faq                  Json                     @default("[]")
  duration             String?
  method               TrainingMethod?
  types                TrainingType[]           @default([])
  // null = belum diisi admin; blok "Tingkat" disembunyikan di publik.
  level                TrainingLevel?
  // null = belum diisi admin; fakta "Sertifikat" disembunyikan di publik.
  certificate          Boolean?
  priceText            String?
  showPrice            Boolean                  @default(false)
  coverId              String?                  @db.Uuid
  cover                Media?                   @relation(fields: [coverId], references: [id], onDelete: SetNull)
  status               ContentStatus            @default(DRAFT)
  publishedAt          DateTime?                @db.Timestamptz(3)
  // Kapan FE terakhir di-revalidate untuk publish ini. Scheduler BE me-revalidate pelatihan yang
  // waktu publish-nya sudah lewat tapi belum di-revalidate (publishRevalidatedAt < publishedAt).
  publishRevalidatedAt DateTime?                @db.Timestamptz(3)
  seo                  Json?
  // Kolom pencarian, diisi trigger DB (lihat migrasi phase2_catalog_search), bukan oleh aplikasi:
  // - searchVector: tsvector config simple_unaccent; bobot A judul, B nama kategori, C ringkasan,
  //   D judul modul materi.
  // - searchTitle : judul lower + unaccent, untuk pencocokan sebagian/typo (pg_trgm).
  searchVector         Unsupported("tsvector")?
  searchTitle          String                   @default("")
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)
  deletedAt            DateTime?                @db.Timestamptz(3)
  updatedById          String?                  @db.Uuid
  updatedBy            User?                    @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  categories TrainingCategory[]
  schedules  Schedule[]
  inquiries  Inquiry[]
  // Galeri foto kegiatan (terpisah dari sampul), urutan = order.
  images     TrainingImage[]

  @@unique([slug], map: "Training_slug_active_key", where: raw("\"deletedAt\" IS NULL"))
  @@index([status])
  @@index([publishedAt])
  @@index([status, publishedAt])
  @@index([deletedAt])
  @@index([searchVector], type: Gin)
  @@index([searchTitle(ops: raw("gin_trgm_ops"))], type: Gin)
}

model TrainingImage {
  trainingId String   @db.Uuid
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  mediaId    String   @db.Uuid
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  order      Int      @default(0)

  @@id([trainingId, mediaId])
  @@index([trainingId, order])
  @@index([mediaId])
}

model TrainingCategory {
  trainingId String   @db.Uuid
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  categoryId String   @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([trainingId, categoryId])
  @@index([categoryId])
}

model Schedule {
  id          String         @id @default(uuid(7)) @db.Uuid
  trainingId  String         @db.Uuid
  training    Training       @relation(fields: [trainingId], references: [id], onDelete: Restrict)
  startDate   DateTime       @db.Date
  endDate     DateTime       @db.Date
  city        String?
  venue       String?
  method      TrainingMethod
  // Rupiah, tanpa desimal.
  price       Int?
  status      ScheduleStatus @default(OPEN)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?      @db.Timestamptz(3)
  updatedById String?        @db.Uuid
  updatedBy   User?          @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([trainingId])
  @@index([startDate])
  @@index([status])
  @@index([city])
  @@index([deletedAt])
}

// ===== Klien, testimoni, portofolio, kontak =====

model Client {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  logoId      String?   @db.Uuid
  logo        Media?    @relation(fields: [logoId], references: [id], onDelete: SetNull)
  url         String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  updatedById String?   @db.Uuid
  updatedBy   User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([order])
  @@index([deletedAt])
}

model Testimonial {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  // Jabatan orang yang memberi testimoni (bukan role user admin).
  role        String?
  company     String?
  quote       String
  photoId     String?   @db.Uuid
  photo       Media?    @relation(fields: [photoId], references: [id], onDelete: SetNull)
  order       Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  updatedById String?   @db.Uuid
  updatedBy   User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([order])
  @@index([deletedAt])
}

model PortfolioItem {
  id           String                 @id @default(uuid(7)) @db.Uuid
  title        String
  activityType PortfolioActivityType?
  date         DateTime?              @db.Date
  client       String?
  description  String?
  order        Int                    @default(0)
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime?              @db.Timestamptz(3)
  updatedById  String?                @db.Uuid
  updatedBy    User?                  @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  images PortfolioImage[]

  @@index([order])
  @@index([date])
  @@index([deletedAt])
}

// Galeri portofolio, diurutkan lewat `order`.
model PortfolioImage {
  portfolioItemId String        @db.Uuid
  portfolioItem   PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  mediaId         String        @db.Uuid
  media           Media         @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  order           Int           @default(0)

  @@id([portfolioItemId, mediaId])
  @@index([portfolioItemId, order])
  @@index([mediaId])
}

model MarketingContact {
  id             String    @id @default(uuid(7)) @db.Uuid
  name           String
  // Wilayah/segmen yang ditangani (mis. "Instansi pemerintah"). null = tidak tampil.
  area           String?
  photoId        String?   @db.Uuid
  photo          Media?    @relation(fields: [photoId], references: [id], onDelete: SetNull)
  phone          String
  defaultMessage String?
  order          Int       @default(0)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime? @db.Timestamptz(3)
  updatedById    String?   @db.Uuid
  updatedBy      User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([order])
  @@index([deletedAt])
}

model MediaPartner {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  url         String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
  updatedById String?   @db.Uuid
  updatedBy   User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([order])
  @@index([deletedAt])
}

// ===== Media =====

model Media {
  id           String    @id @default(uuid(7)) @db.Uuid
  path         String    @unique
  // Nama file asli saat diupload, untuk pencarian. File di disk memakai nama acak.
  originalName String?
  mime         String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  folder       String?
  variants     Json?
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)
  updatedById  String?   @db.Uuid
  updatedBy    User?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  trainingCovers    Training[]
  serviceImages     Service[]
  clientLogos       Client[]
  testimonialPhotos Testimonial[]
  marketingPhotos   MarketingContact[]
  portfolioImages   PortfolioImage[]
  trainingImages    TrainingImage[]
  categoryImages    Category[]

  @@index([folder])
  @@index([deletedAt])
}

// ===== Inquiry =====

model Inquiry {
  id             String        @id @default(uuid(7)) @db.Uuid
  name           String
  company        String?
  email          String
  phone          String?
  trainingId     String?       @db.Uuid
  training       Training?     @relation(fields: [trainingId], references: [id], onDelete: SetNull)
  message        String?
  // Pelatihan yang diminati sebagai teks bebas (form /kontak tanpa pilihan pelatihan).
  interest       String?
  source         InquirySource @default(CONTACT)
  // Persetujuan pemrosesan data (UU PDP): waktu centang + versi teks persetujuan (di kode).
  consentAt      DateTime?     @db.Timestamptz(3)
  consentVersion String?
  status         InquiryStatus @default(NEW)
  note           String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?     @db.Timestamptz(3)
  updatedById    String?       @db.Uuid
  updatedBy      User?         @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([trainingId])
  @@index([deletedAt])
}

// ===== SEO & audit =====

model Redirect {
  id          String       @id @default(uuid(7)) @db.Uuid
  from        String
  to          String
  code        RedirectCode @default(PERMANENT)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?    @db.Timestamptz(3)
  updatedById String?      @db.Uuid
  updatedBy   User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([from], map: "Redirect_from_active_key", where: raw("\"deletedAt\" IS NULL"))
  @@index([deletedAt])
}

model AuditLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  diff      Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}
