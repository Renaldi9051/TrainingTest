{
  "name": "training-be",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../.env -- next dev -p 4000",
    "dev:e2e": "tsx scripts/e2e-dev.ts",
    "build": "dotenv -e ../.env -- next build",
    "start": "dotenv -e ../.env -- next start -p 4000",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run check:utf8 && npm run lint && npm run typecheck && npm run test",
    "check:utf8": "node scripts/check-utf8.mjs",
    "db:up": "docker compose -f ../compose.yaml --env-file ../.env up -d --wait db",
    "db:down": "docker compose -f ../compose.yaml --env-file ../.env stop db",
    "stack:down": "docker compose -f ../compose.yaml --env-file ../.env down",
    "db:logs": "docker compose -f ../compose.yaml --env-file ../.env logs -f db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:e2e:reset": "tsx scripts/e2e-db-reset.ts",
    "e2e:cleanup": "tsx scripts/e2e-uploads-cleanup.ts",
    "db:sync-content": "dotenv -e ../.env -- tsx scripts/sync-content-dev.ts",
    "db:seed:bulk": "dotenv -e ../.env -- prisma db seed -- --bulk",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "bench:search": "dotenv -e ../.env -- tsx scripts/bench-search.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dompurify": "^3.4.16",
    "file-type": "^22.1.1",
    "jsdom": "^29.1.1",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
